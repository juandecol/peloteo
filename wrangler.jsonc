{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "peloteo",
  "main": "src/index.ts",
  // Fecha soportada por el workerd instalado (1.20261110.x).
  "compatibility_date": "2026-11-10",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Las rutas de API y administración pasan primero por el Worker.
    "run_worker_first": ["/api/*", "/admin/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "peloteo",
      // Base creada con `wrangler d1 create peloteo` (región ENAM).
      "database_id": "5ef5a640-578f-409b-be4e-a162a1f5ab25",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "TIMEZONE": "America/Santiago",
    // Correos de aviso con Resend. La clave es el secret RESEND_API_KEY
    // (wrangler secret put RESEND_API_KEY), nunca en este archivo.
    // En localhost los correos se muestran en la consola y no se envían.
    "EMAIL_MODE": "resend",
    "SITE_URL": "https://peloteo.cl",
    "MAIL_FROM": "Peloteo <avisos@peloteo.cl>"
  }
}
