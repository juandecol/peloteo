{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "peloteo",
  "main": "src/index.ts",
  // Fecha soportada por el workerd instalado (1.20261110.x).
  "compatibility_date": "2026-11-10",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Las rutas de API y administración pasan primero por el Worker.
    "run_worker_first": ["/api/*", "/admin/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "peloteo",
      // Marcador para desarrollo local. Antes de desplegar se reemplaza
      // por el ID real que entrega `wrangler d1 create peloteo`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "TIMEZONE": "America/Santiago"
  }
}
